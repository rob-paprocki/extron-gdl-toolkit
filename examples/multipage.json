{
  "name": "Multipage Probe",
  "model": "TLP1035T",
  "size": [
    1280,
    800
  ],
  "_why": "Three pages. Every other example here has exactly one, and so did every test, while the real client fixture has 27 - so nothing had ever exercised page-to-page ID allocation. It works: page numbers 1000/1100/1200 band the control userIds 1001-1005, 1101-1104, 1201-1205 with no collisions. Kept as the smallest spec that proves it.",
  "theme": {
    "background": "#12131C",
    "surface": "#242634",
    "raised": "#2E3142",
    "accent": "#3D8BFD",
    "text": "#FFFFFF",
    "muted": "#BABCCE",
    "font": "Forma DJR Display",
    "size": 16
  },
  "pages": [
    {
      "name": "Home",
      "number": 1000,
      "controls": [
        {
          "kind": "panel",
          "name": "Bar",
          "rect": [
            0,
            0,
            1280,
            96
          ],
          "fill": "surface",
          "border": "rect"
        },
        {
          "kind": "label",
          "name": "Title",
          "rect": [
            32,
            0,
            600,
            96
          ],
          "text": "Home",
          "align": "left",
          "size": 32
        },
        {
          "grid": {
            "rect": [
              32,
              128,
              1216,
              200
            ],
            "cols": 3,
            "gap": 20,
            "kind": "button",
            "fill": "raised",
            "border": "afterburn",
            "items": [
              {
                "text": "Displays"
              },
              {
                "text": "Audio"
              },
              {
                "text": "Cameras"
              }
            ]
          }
        }
      ]
    },
