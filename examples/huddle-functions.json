{
  "name": "Huddle Room",
  "model": "TLP1035T",
  "size": [1280, 800],
  "start_page": "Huddle Home",

  "_brief": "The huddle brief of examples/huddle.json, plus what it DOES, as a verbal overview: 'The three sources route to the display, and the panel shows which one is live. Volume steps while you hold it, and Mute shows whether it is muted. The top bar shows whether a call is up. End Call ends it. Room Off asks first. A Help page explains how to share. Ten minutes untouched and it goes back to the start. Each source shows No Signal, Ready or Live; the Display button shows Off, Warming, On or Cooling.' Page flips are `nav`, which is checked; everything else is `does`, in words, for the programmer. Buttons with more than Off/On name their `states`. `python -m gdl.idmap write` turns it into the ID map.",
  "_seed": "Clean-room: built against seeds/Afterburn 1035.gdl, so Open Sans rather than the client fixture's retail face.",

  "theme": {
    "background": "#12131C",
    "surface": "#242634",
    "raised": "#2E3142",
    "danger": "#C0392B",
    "text": "#FFFFFF",
    "accent": "#3D8BFD",
    "font": "Open Sans",
    "size": 18,
    "on": "accent"
  },

  "does": "After ten minutes without a touch, close any popup and return to Huddle Home.",

  "pages": [
    {
      "name": "Huddle Home",
      "number": 1000,
      "controls": [
        { "kind": "panel", "name": "TopBar", "rect": [0, 0, 1280, 112],
          "fill": "surface", "border": "rect" },
        { "kind": "label", "name": "RoomName", "rect": [40, 0, 520, 112],
          "text": "Huddle Room", "align": "left", "size": 40 },
        { "kind": "label", "name": "CallState", "rect": [560, 0, 440, 112],
          "text": "No call in progress", "align": "right", "size": 20,
          "does": "Shows the codec's call status." },
        { "kind": "button", "name": "HelpBtn", "rect": [1040, 24, 200, 64],
          "text": "Help", "fill": "raised", "border": "afterburn",
          "nav": "Huddle Help" },

        { "kind": "label", "name": "PickSource", "rect": [40, 148, 700, 36],
          "text": "Share something", "align": "left", "size": 16 },

        { "grid": {
            "rect": [40, 196, 1200, 272],
            "cols": 3, "gap": 24,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "states": [
              { "name": "No Signal", "fill": "surface" },
              "Ready",
              { "name": "Live", "fill": "accent" }
            ],
            "press": "Live",
            "items": [
              { "name": "Laptop", "text": "Laptop",
                "does": "Routes the laptop input to the display. No Signal until a laptop is connected, Ready once one is, Live while it is on the display." },
              { "name": "Wireless", "text": "Wireless",
                "does": "Routes wireless presentation to the display. No Signal until someone is sharing, Ready once they are, Live while it is on the display." },
              { "name": "RoomPC", "text": "Room PC",
                "does": "Routes the room PC to the display. No Signal while the PC is asleep, Ready when it is awake, Live while it is on the display." }
            ]
          }
        },

        { "kind": "panel", "name": "VolumeWell", "rect": [40, 500, 760, 220],
          "fill": "surface", "border": "afterburn-flat" },
        { "kind": "label", "name": "VolumeLabel", "rect": [72, 500, 300, 60],
          "text": "Volume", "align": "left", "size": 20 },
        { "kind": "slider", "name": "VolumeSlider", "rect": [72, 564, 696, 60],
          "orientation": "right", "fill": "raised",
          "does": "Sets program volume, 0-100; follows the DSP's level." },
        { "grid": {
            "rect": [72, 636, 696, 72],
            "cols": 3, "gap": 16,
            "kind": "button", "fill": "raised", "border": "afterburn",
            "items": [
              { "name": "Mute", "text": "Mute", "on": "danger",
                "does": "Toggles program mute; On while muted." },
              { "name": "VolDown", "text": "–",
                "does": "Volume down one step; repeats while held." },
              { "name": "VolUp", "text": "+",
                "does": "Volume up one step; repeats while held." }
            ]
          }
        },

        { "kind": "button", "name": "EndCall", "rect": [872, 500, 368, 220],
          "text": "End Call", "fill": "danger", "border": "afterburn",
          "size": 26, "does": "Ends the call." },

        { "kind": "panel", "name": "StatusStrip", "rect": [0, 736, 1280, 64],
          "fill": "surface", "border": "rect" },
        { "kind": "label", "name": "Status", "rect": [40, 736, 800, 64],
          "text": "Ready", "align": "left", "size": 16,
          "does": "Shows room status messages." },
        { "kind": "button", "name": "Display", "rect": [860, 740, 180, 56],
          "text": "Display Off", "fill": "raised", "border": "afterburn", "size": 16,
          "states": [
            "Off",
            { "name": "Warming", "fill": "surface", "text": "Warming Up" },
            { "name": "On", "fill": "accent", "text": "Display On" },
            { "name": "Cooling", "fill": "surface", "text": "Cooling Down" }
          ],
          "press": "On",
          "does": "Toggles display power. Shows the display's power state: Off, Warming, On or Cooling." },
        { "kind": "button", "name": "RoomOff", "rect": [1060, 740, 180, 56],
          "text": "Room Off", "fill": "raised", "border": "afterburn", "size": 16,
          "nav": "Confirm Room Off" }
      ]
    },
    {
      "name": "Huddle Help",
      "number": 1100,
      "controls": [
        { "kind": "panel", "name": "HelpBar", "rect": [0, 0, 1280, 112],
          "fill": "surface", "border": "rect" },
        { "kind": "label", "name": "HelpTitle", "rect": [40, 0, 700, 112],
          "text": "How to share", "align": "left", "size": 40 },
        { "kind": "label", "name": "Step1", "rect": [40, 160, 1200, 60],
          "text": "1. Connect your laptop, or start wireless sharing.", "align": "left" },
        { "kind": "label", "name": "Step2", "rect": [40, 240, 1200, 60],
          "text": "2. Tap its button on the home page.", "align": "left" },
        { "kind": "label", "name": "Step3", "rect": [40, 320, 1200, 60],
          "text": "3. End the call from the red button when you are done.", "align": "left" },
        { "kind": "button", "name": "Back", "rect": [40, 640, 280, 100],
          "text": "Back", "fill": "raised", "border": "afterburn",
          "nav": "Huddle Home" }
      ]
    }
  ],

  "popups": [
    {
      "name": "Confirm Room Off",
      "number": 9100,
      "modal": true,
      "controls": [
        { "kind": "panel", "name": "Card", "rect": [380, 250, 520, 300],
          "fill": "surface", "border": "afterburn-flat" },
        { "kind": "label", "name": "Question", "rect": [400, 270, 480, 120],
          "text": "Shut the room down?", "size": 22 },
        { "kind": "button", "name": "ShutDown", "rect": [410, 440, 220, 80],
          "text": "Shut Down", "fill": "danger", "border": "afterburn",
          "does": "Powers the display and audio off, then closes this popup." },
        { "kind": "button", "name": "Cancel", "rect": [650, 440, 220, 80],
          "text": "Cancel", "fill": "raised", "border": "afterburn",
          "does": "Closes this popup." }
      ]
    }
  ]
}
